# GitHub OAuth app credentials (https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Public URL of this server. The GitHub app's callback URL must be {BASE_URL}/auth/callback
BASE_URL=http://localhost:8000

# Bind address
HOST=127.0.0.1
PORT=8000

# Space-separated GitHub scopes required on every token
GITHUB_SCOPES=read:user

# Optional: secret used to sign the tokens this server issues to MCP clients.
# Defaults to a key derived from GITHUB_CLIENT_SECRET.
JWT_SIGNING_KEY=
